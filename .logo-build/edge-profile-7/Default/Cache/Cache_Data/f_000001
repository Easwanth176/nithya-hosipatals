    <section id="care" class="band" aria-labelledby="care-title">
      <div class="band-intro">
        <p class="kicker">Clinical work</p>
        <h2 id="care-title">What is treated here</h2>
      </div>
      <ol class="care-list">
        <li>
          <button type="button" class="care-card" aria-pressed="false">
            <span class="cartoon"><svg><use href="#c-teen"/></svg></span>
            <span class="care-title">Adolescent health and HPV vaccination</span>
            <span class="care-text">A private visit for teenagers, including the vaccine schedule and questions they would rather not raise in a group.</span>
            <span class="picked">Selected</span>
          </button>
        </li>
        <li>
          <button type="button" class="care-card" aria-pressed="false">
            <span class="cartoon"><svg><use href="#c-pcod"/></svg></span>
            <span class="care-title">PCOD treatment</span>
            <span class="care-text">Irregular cycles, skin changes, and weight are handled as one picture, not as separate complaints.</span>
            <span class="picked">Selected</span>
          </button>
        </li>
        <li>
          <button type="button" class="care-card" aria-pressed="false">
            <span class="cartoon"><svg><use href="#c-two"/></svg></span>
            <span class="care-title">Infertility treatment</span>
            <span class="care-text">Both partners can be investigated. Choices are laid out before anyone is asked to decide.</span>
            <span class="picked">Selected</span>
          </button>
        </li>
        <li>
          <button type="button" class="care-card" aria-pressed="false">
            <span class="cartoon"><svg><use href="#c-baby"/></svg></span>
            <span class="care-title">High-risk pregnancy care</span>
            <span class="care-text">Closer checks when blood pressure, sugar, or the baby’s growth needs a written plan.</span>
            <span class="picked">Selected</span>
          </button>
        </li>
        <li>
          <button type="button" class="care-card" aria-pressed="false">
            <span class="cartoon"><svg><use href="#c-cradle"/></svg></span>
            <span class="care-title">Normal deliveries and caesarean sections</span>
            <span class="care-text">Labour is attended throughout. An operation is recommended only when a vaginal birth would not be safe.</span>
            <span class="picked">Selected</span>
          </button>
        </li>
        <li>
          <button type="button" class="care-card" aria-pressed="false">
            <span class="cartoon"><svg><use href="#c-scope-heart"/></svg></span>
            <span class="care-title">Gynaecological problems</span>
            <span class="care-text">Pain, bleeding, discharge, and infection are examined before a procedure is named.</span>
            <span class="picked">Selected</span>
          </button>
        </li>
        <li>
          <button type="button" class="care-card" aria-pressed="false">
            <span class="cartoon"><svg><use href="#c-sun"/></svg></span>
            <span class="care-title">Menopause care</span>
            <span class="care-text">Hot flushes, sleep, mood, and bones are reviewed in the same sitting.</span>
            <span class="picked">Selected</span>
          </button>
        </li>
        <li>
          <button type="button" class="care-card" aria-pressed="false">
            <span class="cartoon"><svg><use href="#c-keyhole"/></svg></span>
            <span class="care-title">Laparoscopic surgeries</span>
            <span class="care-text">Selected operations use small incisions, so the stay on the ward is usually shorter.</span>
            <span class="picked">Selected</span>
          </button>
        </li>
      </ol>
      <p id="care-status" class="fine" aria-live="polite">Select a concern. It is added to the consultation request.</p>
    </section>

    <section id="doctors" class="band" aria-labelledby="doctors-title">
      <div class="band-intro">
        <p class="kicker">The consultant</p>
        <h2 id="doctors-title">Doctors</h2>
      </div>
      <button type="button" class="doctor" id="choose-doctor" aria-pressed="false">
        <span class="cartoon"><svg><use href="#c-doctor"/></svg></span>
        <span class="doctor-name">Dr Guntur Kiranmai</span>
        <span class="role">Obstetrics and gynaecology</span>
        <span class="doctor-line">Patients at this hospital are seen by her.</span>
        <span class="picked when-off">Choose for the consultation</span>
        <span class="picked when-on">Chosen for the consultation</span>
      </button>
    </section>

    <section id="consultation" class="band" aria-labelledby="consult-title">
      <div class="band-intro">
        <p class="kicker">From home</p>
        <h2 id="consult-title">Online consultation</h2>
        <p class="section-note">For advice, a look at reports, or a follow-up on a day when an examination is not required.</p>
      </div>
      <form id="request" class="request" novalidate>
        <div class="progress" role="tablist" aria-label="Request steps">
          <button type="button" id="tab-1" role="tab" aria-selected="true" aria-controls="panel-1">Call</button>
          <button type="button" id="tab-2" role="tab" aria-selected="false" aria-controls="panel-2">Time</button>
          <button type="button" id="tab-3" role="tab" aria-selected="false" aria-controls="panel-3">Details</button>
        </div>
        <p id="live-request" class="live-request" aria-live="polite">Choose how the conversation should happen.</p>

        <fieldset id="panel-1" data-panel="1">
          <legend>How should the call happen?</legend>
          <div class="choices" role="group" aria-label="Call type">
            <button type="button" class="chip" data-group="mode" data-value="Video" aria-pressed="false"><svg class="chip-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="6" width="12" height="12" rx="2" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M15 10l6-3v10l-6-3z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>Video</button>
            <button type="button" class="chip" data-group="mode" data-value="Phone" aria-pressed="false"><svg class="chip-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3h4l1 4-2 1a12 12 0 0 0 6 6l1-2 4 1v4c0 1-1 2-2 2C10 19 5 14 5 5c0-1 1-2 2-2z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>Phone</button>
          </div>
        </fieldset>

        <fieldset id="panel-2" data-panel="2" hidden>
          <legend>When is a good time?</legend>
          <label>
            Day
            <input name="day" type="date">
          </label>
          <div class="choices" role="group" aria-label="Part of day">
            <button type="button" class="chip" data-group="slot" data-value="Morning" aria-pressed="false">Morning</button>
            <button type="button" class="chip" data-group="slot" data-value="Afternoon" aria-pressed="false">Afternoon</button>
            <button type="button" class="chip" data-group="slot" data-value="Evening" aria-pressed="false">Evening</button>
          </div>
        </fieldset>

        <fieldset id="panel-3" data-panel="3" hidden>
          <legend>Who is the appointment for?</legend>
          <div class="fields">
            <label>
              Full name
              <input name="name" type="text" autocomplete="name">
            </label>
            <label>
              Phone
              <input name="phone" type="tel" autocomplete="tel" inputmode="tel">
            </label>
            <label class="wide">
              What should be discussed
              <textarea name="note" rows="4"></textarea>
            </label>
          </div>
        </fieldset>

        <p id="form-error" class="form-error" role="alert" hidden></p>
        <div class="wizard-actions">
          <button class="text-link" type="button" id="back" hidden>Back</button>
          <button class="button" type="button" id="next">Continue</button>
          <button class="button" type="submit" id="submit" hidden>Submit request</button>
        </div>
        <p class="fine">The note stays in this browser. It is not sent until a hospital phone or email is connected.</p>
      </form>

      <div id="request-done" class="done" hidden>
        <h3 tabindex="-1">Request noted on this page</h3>
        <dl>
          <div><dt>Concern</dt><dd data-field="concern"></dd></div>
          <div><dt>Call</dt><dd data-field="mode"></dd></div>
          <div><dt>When</dt><dd data-field="when"></dd></div>
          <div><dt>Doctor</dt><dd data-field="doctor"></dd></div>
          <div><dt>Name</dt><dd data-field="name"></dd></div>
          <div><dt>Phone</dt><dd data-field="phone"></dd></div>
          <div><dt>Note</dt><dd data-field="note"></dd></div>
        </dl>
        <p>Read this back at reception, or keep it until the hospital can receive it directly.</p>
        <button class="text-link" type="button" id="edit-request">Edit the request</button>
      </div>
    </section>

    <section id="visit" class="band" aria-labelledby="visit-title">
      <div class="band-intro">
        <p class="kicker">Find the building</p>
        <h2 id="visit-title">Visit</h2>
      </div>
      <address>
        CXVW+VCC, Gudivada Bypass Rd<br>
        Teacher Colony, Satyanarayana Puram<br>
        Valivarthipadu Rural, Gudivada<br>
        Andhra Pradesh 521301
      </address>
      <div class="visit-actions">
        <a class="text-link" href="https://www.google.com/maps/search/?api=1&amp;query=CXVW%2BVCC%20Gudivada%20Bypass%20Rd%20Teacher%20Colony%20Satyanarayana%20Puram%20Valivarthipadu%20Rural%20Gudivada%20521301" target="_blank" rel="noopener noreferrer">Open in Google Maps</a>
        <button type="button" class="text-link" id="copy-address">Copy address</button>
      </div>
    </section>
