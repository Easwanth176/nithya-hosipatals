  <main id="content">
    <section class="hero">
      <div class="hero-copy">
        <p class="kicker">Private hospital</p>
        <h1>A calm appointment, with the next step made plain.</h1>
        <p class="lede">Come to the building, or arrange a video or phone conversation when travel should wait.</p>
        <div class="hero-actions">
          <a class="button" href="#consultation">Request a consultation</a>
          <a class="text-link" href="#visit">Directions</a>
        </div>
      </div>
      <div class="hero-art" aria-hidden="true">
