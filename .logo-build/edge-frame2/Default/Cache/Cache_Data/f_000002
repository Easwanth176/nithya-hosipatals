:root {
  --blue: #025eea;
  --blue-dark: #0147b8;
  --blue-soft: #eaf2ff;
  --pink: #f8659b;
  --pink-text: #c92a66;
  --pink-soft: #fff0f6;
  --green: #1f8a4c;
  --green-dark: #17703d;
  --danger: #b0234f;
  --ink: #35383d;
  --text: #555a61;
  --muted: #6b7077;
  --line: #e9ebef;
  --field: #b8bec7;
  --white: #ffffff;
  --skin: #f6d2c0;
  --hair: #3d342f;
  --stroke: #1a1a1a;
  --font: "Poppins", "Poppins Fallback", "Noto Sans Telugu", "Segoe UI", Helvetica, Arial, sans-serif;
  --measure: 72rem;
  --radius: 20px;
  --radius-sm: 12px;
  --shadow: 0 10px 40px rgba(0, 0, 0, 0.08);
  --shadow-blue: 0 15px 20px rgba(2, 94, 234, 0.22);
  --shadow-pink: 0 4px 16px rgba(248, 101, 155, 0.22);
  --ease: 0.5s ease;
}

@font-face {
  font-family: "Poppins Fallback";
  src: local("Arial");
  size-adjust: 112.1%;
  ascent-override: 93.75%;
  descent-override: 31.25%;
  line-gap-override: 8.93%;
}

* { box-sizing: border-box; }

[hidden] { display: none !important; }

html { scroll-behavior: smooth; overflow-x: clip; }

body {
  margin: 0;
  background: var(--white);
  color: var(--text);
  font-family: var(--font);
  font-size: 1rem;
  font-weight: 400;
  line-height: 1.7;
  overflow-x: clip;
  padding-bottom: 5.5rem;
}

img { max-width: 100%; height: auto; display: block; }

a { color: var(--blue); }

.skip {
  position: absolute;
  left: 1rem;
  top: -3rem;
  background: var(--white);
  padding: 0.4rem 0.7rem;
  z-index: 20;
}

.skip:focus { top: 0.5rem; }

.sprite { position: absolute; width: 0; height: 0; overflow: hidden; }

.f-skin { fill: var(--skin); }
.f-hair { fill: var(--hair); }
.f-ink { fill: var(--stroke); }
.s-ink { stroke: var(--stroke); }
.f-white { fill: var(--white); }
.f-pink { fill: var(--pink); }
.f-blue { fill: var(--blue); }
.s-pink { stroke: var(--pink); }
.s-blue { stroke: var(--blue); }

.ico {
  width: 1.05em;
  height: 1.05em;
  flex: none;
  fill: none;
  stroke: currentColor;
  stroke-width: 2;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.nowrap { white-space: nowrap; }

html[lang="te"] body { line-height: 1.85; }

html[lang="te"] .kicker { letter-spacing: 0; text-transform: none; }

/* Top bar */

.topbar {
  background: var(--white);
  border-bottom: 1px solid var(--line);
  font-size: 0.85rem;
}

.topbar-inner {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 0.35rem 1.5rem;
  width: min(var(--measure), calc(100vw - 3rem));
  margin: 0 auto;
  padding: 0.4rem 0;
}

.topbar-item {
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  color: var(--text);
}

.topbar-item .ico { color: var(--blue); }

.topbar-call {
  color: var(--pink-text);
  font-weight: 500;
  text-decoration: none;
}

.topbar-call .ico { color: var(--pink-text); }

.topbar-call:hover .nowrap { text-decoration: underline; text-underline-offset: 0.2em; }

/* Header */

.site-header {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  gap: 1.5rem;
  width: 100%;
  max-width: 100vw;
  padding: 0.75rem 1.5rem;
  background: var(--white);
  box-shadow: 0 1px 0 rgba(0, 0, 0, 0.06);
  transition: padding var(--ease), box-shadow var(--ease);
}

.site-header.is-compact {
  padding-top: 0.35rem;
  padding-bottom: 0.35rem;
  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
}

.logo-link { display: block; flex: 0 0 auto; min-width: 0; }

.logo-link img {
  height: 68px;
  width: 84px;
  object-fit: contain;
  transition: height var(--ease), width var(--ease);
}

.site-header.is-compact .logo-link img { height: 50px; width: 62px; }

.site-nav {
  display: flex;
  gap: 0.35rem;
  margin-left: auto;
}

.site-nav a {
  color: var(--ink);
  text-decoration: none;
  font-size: 0.95rem;
  font-weight: 500;
  padding: 0.45rem 0.9rem;
  border-radius: 30px;
  transition: all 0.2s ease-in-out;
}

.site-nav a:hover,
.site-nav a:focus-visible { color: var(--blue); background: var(--blue-soft); }

.site-nav a[aria-current="true"] { color: var(--white); background: var(--blue); }

.header-actions {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  flex: none;
}

.lang-switch,
.menu-button {
  background: var(--white);
  color: var(--ink);
  border: 1px solid var(--field);
  border-radius: 30px;
  padding: 0.45rem 1rem;
  font: 500 0.9rem var(--font);
  cursor: pointer;
  transition: all 0.3s ease-in-out;
}

.lang-switch:hover { border-color: var(--blue); color: var(--blue); }

.call-button {
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  padding: 0.5rem 1.1rem;
  border-radius: 50px;
  background: var(--pink-text);
  color: var(--white);
  text-decoration: none;
  font-weight: 500;
  font-size: 0.92rem;
  transition: all var(--ease);
}

.call-button:hover,
.call-button:focus-visible {
  background: var(--blue);
  box-shadow: var(--shadow-blue);
  transform: translateY(-3px);
}

.menu-button { display: none; }

/* Layout */

.hero,
.band {
  width: min(var(--measure), calc(100vw - 3rem));
  margin: 0 auto;
}

.band { padding: 4.5rem 0 0; scroll-margin-top: 6.5rem; }

.band-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 1.5rem;
  margin-bottom: 1.75rem;
}

.band-head .band-intro { margin-bottom: 0; }

.band-intro { max-width: 38rem; margin-bottom: 1.75rem; }

.kicker {
  display: inline-block;
  margin: 0 0 0.75rem;
  padding: 0.25rem 0.85rem;
  color: var(--pink-text);
  background: var(--pink-soft);
  border-radius: 30px;
  font-size: 0.78rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

h1, h2, h3 { color: var(--ink); font-family: var(--font); }

h1 {
  margin: 0;
  max-width: 18ch;
  font-size: clamp(2.2rem, 4.2vw, 3.3rem);
  font-weight: 600;
  line-height: 1.2;
}

h1 em { font-style: normal; color: var(--blue); }

h2 {
  margin: 0;
  font-size: clamp(1.7rem, 2.6vw, 2.25rem);
  font-weight: 600;
  line-height: 1.25;
}

h2::after {
  content: "";
  display: block;
  width: 56px;
  height: 4px;
  margin-top: 0.7rem;
  border-radius: 4px;
  background: linear-gradient(90deg, var(--blue), var(--pink));
}

.section-note { margin: 0.9rem 0 0; }

/* Hero */

.hero {
  display: grid;
  grid-template-columns: minmax(0, 1.1fr) minmax(220px, 0.9fr);
  align-items: center;
  gap: 2rem;
  padding: 3.5rem 0 1rem;
}

.lede {
  max-width: 36rem;
  margin: 1.1rem 0 0;
  font-size: 1.1rem;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 1.25rem;
  margin-top: 2rem;
}

.hero-art { position: relative; }

.replay {
  position: absolute;
  right: 0.25rem;
  bottom: 0.25rem;
  display: grid;
  place-items: center;
  width: 42px;
  height: 42px;
  border-radius: 50%;
  border: 1px solid var(--field);
  background: var(--white);
  color: var(--ink);
  cursor: pointer;
  box-shadow: var(--shadow);
  animation: zoomEffect 0.4s ease-in-out;
  transition: all 0.3s ease-in-out;
}

.replay .ico { width: 20px; height: 20px; }

.replay:hover { background: var(--blue); border-color: var(--blue); color: var(--white); transform: rotate(-90deg); }

.hero-art svg { width: 100%; max-width: 520px; height: auto; display: block; margin-left: auto; }

.building { overflow: visible; }

.building .layer { transition: transform 0.6s ease-out; }

.building .backdrop {
  fill: var(--blue-soft);
  transform-box: fill-box;
  transform-origin: center;
  transform: scale(0);
}

.building .backdrop.b2 { fill: var(--pink-soft); }

.building .wash { opacity: 0; }

.building .w-glass { fill: #f3f8ff; }
.building .w-glass-band { fill: #e1edff; }
.building .w-body { fill: var(--white); }
.building .w-canopy { fill: var(--pink-soft); }
.building .w-door { fill: #dbe8fd; }
.building .w-tree { fill: #e2f1e7; }

.building .win { fill: #e6efff; opacity: 0; }

.building .cloud { opacity: 0; }

.building .cloud path {
  fill: var(--white);
  stroke: #bcd0f2;
  stroke-width: 1.5;
}

.building .bird {
  opacity: 0;
  fill: none;
  stroke: var(--ink);
  stroke-width: 1.5;
  stroke-linecap: round;
}

.building .lane {
  fill: none;
  stroke: #c5ceda;
  stroke-width: 2;
  stroke-dasharray: 14 12;
  opacity: 0;
}

.building .ambulance { transform: translateX(-380px); }

.building .amb-body { fill: var(--white); stroke: var(--ink); stroke-width: 1.8; stroke-linejoin: round; }
.building .amb-glass { fill: var(--blue-soft); stroke: var(--ink); stroke-width: 1.2; stroke-linejoin: round; }
.building .amb-stripe { stroke: var(--blue); stroke-width: 2.5; }
.building .amb-cross { stroke: var(--pink); stroke-width: 3.5; stroke-linecap: round; }
.building .beacon { fill: var(--pink); }

.building .wheel { transform-box: fill-box; transform-origin: center; }
.building .wheel circle { fill: var(--white); stroke: var(--ink); stroke-width: 2; }
.building .wheel path { stroke: var(--ink); stroke-width: 1.2; }

.building .walker { opacity: 0; transform: translateX(120px); }
.building .walker-2 { transform: translateX(132px); }

.building .person { stroke-width: 1.4; }
.building .coat { fill: var(--pink-soft); stroke: var(--pink-text); stroke-width: 1.3; stroke-linejoin: round; }
.building .coat-blue { fill: var(--blue-soft); stroke: var(--blue); }
.building .limb { fill: none; stroke: var(--ink); stroke-width: 1.5; stroke-linecap: round; }

.building.is-drawing .backdrop { animation: zoomEffect 1s ease-in-out forwards; animation-delay: var(--t, 0ms); }
.building.is-drawing .wash { animation: fade 0.9s ease forwards; animation-delay: var(--t, 0ms); }
.building.is-drawing .win { animation: fade 0.5s ease forwards; animation-delay: var(--t, 0ms); }
.building.is-drawing .win.lit { animation: fade 0.5s ease forwards, light 0.7s ease forwards; animation-delay: var(--t, 0ms), var(--lit, 0ms); }
.building.is-drawing .lane { animation: fade 0.8s ease forwards; animation-delay: var(--t, 0ms); }

.building.is-drawing .cloud {
  animation: fade 1.2s ease forwards, drift 16s ease-in-out infinite alternate;
  animation-delay: var(--t, 0ms), var(--t, 0ms);
}

.building.is-drawing .cloud-2 { animation-duration: 1.2s, 20s; }

.building.is-drawing .bird {
  animation: fly-in 2.4s cubic-bezier(0.2, 0.7, 0.3, 1) forwards;
  animation-delay: var(--t, 0ms);
}

.building.is-drawing .ambulance {
  animation: drive 2s cubic-bezier(0.2, 0.75, 0.25, 1) forwards;
  animation-delay: var(--t, 0ms);
}

.building.is-drawing .wheel {
  animation: spin 0.5s linear 4;
  animation-delay: var(--t, 0ms);
}

.building.is-drawing .beacon {
  animation: beacon 1.6s ease-in-out infinite;
  animation-delay: var(--t, 0ms);
}

.building.is-drawing .walker {
  animation: walk 2.6s cubic-bezier(0.25, 0.6, 0.35, 1) forwards;
  animation-delay: var(--t, 0ms);
}

.building.is-drawing .step {
  animation: step 0.32s ease-in-out 7 alternate;
  animation-delay: var(--t, 0ms);
}

.building.is-done .backdrop,
.building.is-done .ambulance,
.building.is-done .walker { transform: none; }

.building.is-done .wash,
.building.is-done .win,
.building.is-done .cloud,
.building.is-done .bird,
.building.is-done .walker { opacity: 1; }

.building.is-done .lane { opacity: 1; }

.building.is-done .win.lit { fill: #ffd6e5; }

.building .ln {
  fill: none;
  stroke: var(--ink);
  stroke-width: 2.1;
  stroke-linecap: round;
  stroke-linejoin: round;
  stroke-dasharray: 1;
  stroke-dashoffset: 1;
}

.building .ln.thin { stroke-width: 1.4; }

.building.is-drawing .ln {
  animation: draw 1.1s cubic-bezier(0.55, 0, 0.3, 1) forwards;
  animation-delay: var(--t, 0ms);
}

.building .badge {
  opacity: 0;
  transform-box: fill-box;
  transform-origin: center;
  transform: scale(0);
}

.building.is-drawing .badge {
  animation: pop 0.7s cubic-bezier(0.3, 1.5, 0.5, 1) forwards;
  animation-delay: var(--t, 0ms);
}

.building .ltr {
  font: 600 11px var(--font);
  fill: var(--blue);
  text-anchor: middle;
  opacity: 0;
  transform-box: fill-box;
  transform-origin: center;
  transform: translateY(-26px) rotate(-18deg);
}

.building.is-drawing .ltr {
  animation: drop 0.6s cubic-bezier(0.3, 1.4, 0.5, 1) forwards;
  animation-delay: var(--t, 0ms);
}

.building.is-done .ln { stroke-dashoffset: 0; }

.building.is-done .badge,
.building.is-done .ltr { opacity: 1; transform: none; }

@keyframes draw { to { stroke-dashoffset: 0; } }

@keyframes pop {
  0% { opacity: 0; transform: scale(0); }
  100% { opacity: 1; transform: scale(1); }
}

@keyframes drop {
  to { opacity: 1; transform: none; }
}

@keyframes fade { to { opacity: 1; } }

@keyframes light { to { fill: #ffd6e5; } }

@keyframes drift {
  from { transform: translateX(-10px); }
  to { transform: translateX(14px); }
}

@keyframes fly-in {
  from { opacity: 0; transform: translate(-70px, 24px); }
  to { opacity: 1; transform: none; }
}

@keyframes drive { to { transform: none; } }

@keyframes spin { to { transform: rotate(360deg); } }

@keyframes beacon {
  0%, 100% { fill: var(--pink); }
  50% { fill: var(--blue); }
}

@keyframes walk {
  0% { opacity: 0; }
  15% { opacity: 1; }
  100% { opacity: 1; transform: none; }
}

@keyframes step { to { transform: translateY(-1.5px); } }

.zoom-in {
  transform: scale(0);
  animation: zoomEffect 1s forwards ease-in-out;
}

.floater { animation: float 4.8s ease-in-out infinite; }

.floater.late { animation-delay: -2s; }

/* Buttons */

.button {
  display: inline-block;
  background: var(--blue);
  color: var(--white);
  text-decoration: none;
  border: 1px solid var(--blue);
  border-radius: 50px;
  padding: 0.8rem 1.6rem;
  font: 500 1rem var(--font);
  cursor: pointer;
  transition: all var(--ease);
}

.button:hover,
.button:focus-visible {
  background: var(--blue-dark);
  box-shadow: var(--shadow-blue);
  transform: translateY(-7px);
}

.text-link {
  color: var(--blue);
  font-weight: 500;
  text-underline-offset: 0.25em;
  background: none;
  border: 0;
  padding: 0;
  font-family: var(--font);
  font-size: 1rem;
  cursor: pointer;
  transition: color 0.2s;
}

.text-link:hover { color: var(--pink); }

/* Care carousel */

.slider-controls { display: flex; gap: 0.6rem; flex: none; }

.slider-arrow {
  display: grid;
  place-items: center;
  width: 46px;
  height: 46px;
  border-radius: 50%;
  border: 1px solid var(--line);
  background: var(--white);
  color: var(--ink);
  cursor: pointer;
  transition: all 0.3s ease-in-out;
}

.slider-arrow svg { width: 20px; height: 20px; }

.slider-arrow:hover:not(:disabled) {
  background: var(--blue);
  border-color: var(--blue);
  color: var(--white);
  box-shadow: var(--shadow-blue);
}

.slider-arrow:disabled { opacity: 0.4; cursor: default; }

.care-list {
  list-style: none;
  margin: 0 -0.75rem;
  padding: 0.75rem 0.75rem 1.5rem;
  display: grid;
  grid-auto-flow: column;
  grid-auto-columns: calc((100% - 3rem) / 3);
  gap: 1.5rem;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scroll-behavior: smooth;
  scrollbar-width: none;
  counter-reset: care;
}

.care-list::-webkit-scrollbar { display: none; }

.care-list li {
  counter-increment: care;
  scroll-snap-align: start;
  display: flex;
}

.care-card,
.doctor {
  position: relative;
  display: flex;
  flex-direction: column;
  width: 100%;
  text-align: left;
  background: var(--white);
  color: inherit;
  font: inherit;
  cursor: pointer;
  border: 1px solid var(--line);
  border-radius: var(--radius);
  box-shadow: 0 0 4px rgba(215, 226, 232, 1);
  transition: all 0.3s ease-in-out;
}

.care-card { padding: 1.6rem 1.5rem 1.5rem; }

.care-card::before {
  content: counter(care, decimal-leading-zero);
  position: absolute;
  top: 1.2rem;
  right: 1.4rem;
  color: var(--line);
  font-size: 2rem;
  font-weight: 600;
  line-height: 1;
  transition: color 0.3s;
}

.care-card:hover,
.doctor:hover {
  border-color: var(--blue);
  box-shadow: 0 4px 16px rgba(2, 94, 234, 0.16);
  transform: translateY(-3px);
}

.care-card:hover::before { color: var(--pink-soft); }

.care-card[aria-pressed="true"] {
  border-color: var(--pink);
  box-shadow: var(--shadow-pink);
}

.care-card[aria-pressed="true"]::before { color: var(--pink); }

.cartoon {
  display: grid;
  place-items: center;
  width: 78px;
  height: 78px;
  margin-bottom: 1rem;
  border-radius: 50%;
  background: var(--blue-soft);
  transition: all var(--ease);
}

.cartoon svg { width: 62px; height: 62px; }

.care-card:hover .cartoon,
.doctor:hover .cartoon {
  background: var(--pink-soft);
  transform: rotateY(180deg);
}

.care-title,
.doctor-name {
  display: block;
  color: var(--ink);
  font-weight: 600;
  line-height: 1.35;
  transition: color 0.2s;
}

.care-title { font-size: 1.08rem; }

.care-card:hover .care-title,
.doctor:hover .doctor-name { color: var(--blue); }

.care-text,
.doctor-line { display: block; margin: 0.5rem 0 0; font-size: 0.92rem; }

.picked {
  display: none;
  margin-top: auto;
  padding-top: 0.9rem;
  color: var(--pink-text);
  font-size: 0.82rem;
  font-weight: 600;
}

.care-card[aria-pressed="true"] .picked { display: block; }

.slider-dots {
  display: flex;
  justify-content: center;
  gap: 0.45rem;
  margin-top: 0.25rem;
}

.slider-dots span {
  width: 8px;
  height: 8px;
  border-radius: 8px;
  background: var(--line);
  transition: all 0.3s ease;
}

.slider-dots span.is-on { width: 26px; background: var(--blue); }

/* Doctor */

.doctor {
  max-width: 36rem;
  flex-direction: row;
  align-items: center;
  flex-wrap: wrap;
  column-gap: 1.4rem;
  padding: 1.6rem;
}

.doctor .cartoon { margin-bottom: 0; width: 96px; height: 96px; flex: none; }

.doctor .cartoon svg { width: 78px; height: 78px; }

.doctor-text { flex: 1 1 14rem; min-width: 0; }

.doctor-name { font-size: 1.35rem; }

.role {
  display: inline-block;
  margin-top: 0.4rem;
  padding: 0.15rem 0.75rem;
  border-radius: 30px;
  background: var(--blue-soft);
  color: var(--blue);
  font-size: 0.85rem;
  font-weight: 500;
}

.doctor .picked { display: block; margin-top: 0.8rem; padding-top: 0; }

.doctor .when-on { display: none; }

.doctor[aria-pressed="true"] { border-color: var(--pink); box-shadow: var(--shadow-pink); }

.doctor[aria-pressed="true"] .when-off { display: none; }

.doctor[aria-pressed="true"] .when-on { display: block; }

/* Consultation */

.request,
.done {
  max-width: 46rem;
  padding: 2rem;
  border-radius: var(--radius);
  background: var(--white);
  box-shadow: var(--shadow);
}

.progress {
  display: flex;
  gap: 0.5rem;
  margin: 0 0 1.1rem;
  padding: 0.35rem;
  border-radius: 50px;
  background: var(--blue-soft);
  width: fit-content;
  max-width: 100%;
}

.progress button {
  background: none;
  border: 0;
  border-radius: 50px;
  padding: 0.45rem 1.1rem;
  color: var(--muted);
  font: 500 0.92rem var(--font);
  cursor: pointer;
  transition: all 0.3s ease;
}

.progress button[aria-selected="true"] { background: var(--blue); color: var(--white); }

.progress button:disabled { cursor: default; opacity: 0.55; }

fieldset {
  margin: 0 0 1.25rem;
  padding: 0;
  border: 0;
  min-width: 0;
}

legend {
  margin-bottom: 0.85rem;
  color: var(--ink);
  font-size: 1.2rem;
  font-weight: 600;
}

.choices {
  display: flex;
  flex-wrap: wrap;
  gap: 0.6rem;
}

.chip {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  background: var(--white);
  color: var(--ink);
  border: 1px solid var(--field);
  border-radius: 30px;
  padding: 0.6rem 1.15rem;
  font: 500 0.95rem var(--font);
  cursor: pointer;
  transition: all 0.3s ease-in-out;
}

.chip-icon { width: 18px; height: 18px; flex: none; }

.chip:hover { border-color: var(--blue); color: var(--blue); transform: translateY(-2px); }

.chip[aria-pressed="true"] {
  border-color: var(--blue);
  background: var(--blue);
  color: var(--white);
  box-shadow: var(--shadow-blue);
}

.live-request {
  margin: 0 0 1.25rem;
  color: var(--muted);
  font-size: 0.92rem;
}

.wizard-actions {
  display: flex;
  align-items: center;
  gap: 1.25rem;
}

#panel-2 .choices { margin-top: 0.9rem; }

#panel-2 label { max-width: 16rem; }

.fields {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1rem 1.25rem;
}

label {
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
  min-width: 0;
  color: var(--ink);
  font-size: 0.88rem;
  font-weight: 500;
}

.wide { grid-column: 1 / -1; }

input,
textarea {
  width: 100%;
  min-width: 0;
  border: 1px solid var(--field);
  border-radius: var(--radius-sm);
  background: var(--white);
  color: var(--ink);
  font: 400 0.95rem var(--font);
  padding: 0.75rem 0.9rem;
  transition: border-color 0.2s, box-shadow 0.2s;
}

input:focus,
textarea:focus {
  outline: none;
  border-color: var(--blue);
  box-shadow: 0 0 0 4px var(--blue-soft);
}

.button:focus-visible,
.menu-button:focus-visible,
.text-link:focus-visible,
.site-nav a:focus-visible,
.care-card:focus-visible,
.doctor:focus-visible,
.chip:focus-visible,
.slider-arrow:focus-visible,
.progress button:focus-visible,
.lang-switch:focus-visible,
.call-button:focus-visible,
.topbar-call:focus-visible,
.replay:focus-visible,
.faq summary:focus-visible,
.site-footer a:focus-visible,
.dock a:focus-visible {
  outline: 2px solid var(--blue);
  outline-offset: 3px;
}

.form-error {
  color: var(--danger);
  font-weight: 500;
}

.fine {
  display: block;
  margin: 0.9rem 0 0;
  color: var(--muted);
  font-size: 0.85rem;
  max-width: 38rem;
}

.done h3 {
  margin: 0 0 1rem;
  font-size: 1.35rem;
  font-weight: 600;
}

.done p { margin: 0.4rem 0 0; }

.done dl { margin: 0 0 1rem; }

.done dl div {
  display: grid;
  grid-template-columns: 7rem 1fr;
  gap: 0.75rem;
  padding: 0.55rem 0;
  border-top: 1px solid var(--line);
}

.done dt { color: var(--muted); font-weight: 500; }

.done dd { margin: 0; color: var(--ink); overflow-wrap: anywhere; }

.done-actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 1rem 1.25rem;
  margin-top: 1.4rem;
}

.button .ico { margin-right: 0.5rem; vertical-align: -0.15em; }

.button-wa { background: var(--green); border-color: var(--green); }

.button-wa:hover,
.button-wa:focus-visible {
  background: var(--green-dark);
  box-shadow: 0 15px 20px rgba(31, 138, 76, 0.22);
}

.button-ghost { background: var(--white); color: var(--blue); }

.button-ghost:hover,
.button-ghost:focus-visible { color: var(--white); }

/* What to bring */

.prep-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 1.5rem;
}

.prep-card {
  padding: 1.6rem 1.5rem;
  border: 1px solid var(--line);
  border-radius: var(--radius);
  background: var(--white);
  transition: all 0.3s ease-in-out;
}

.prep-card:hover {
  border-color: var(--blue);
  box-shadow: 0 4px 16px rgba(2, 94, 234, 0.16);
  transform: translateY(-3px);
}

.prep-card:hover .cartoon { background: var(--pink-soft); transform: rotateY(180deg); }

.prep-card h3 { margin: 0 0 0.8rem; font-size: 1.1rem; font-weight: 600; }

.chat-mark { color: var(--blue); width: 34px !important; height: 34px !important; }

.checks { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.55rem; }

.checks li { display: flex; gap: 0.6rem; align-items: flex-start; font-size: 0.93rem; }

.checks .ico { color: var(--green); margin-top: 0.3em; }

/* Common questions */

.faq { max-width: 46rem; display: grid; gap: 0.75rem; }

.faq details {
  border: 1px solid var(--line);
  border-radius: var(--radius);
  background: var(--white);
  transition: border-color 0.3s, box-shadow 0.3s;
}

.faq details[open] { border-color: var(--blue); box-shadow: var(--shadow); }

.faq summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  padding: 1.05rem 1.4rem;
  color: var(--ink);
  font-weight: 500;
  cursor: pointer;
  list-style: none;
  border-radius: var(--radius);
}

.faq summary::-webkit-details-marker { display: none; }

.faq summary:hover { color: var(--blue); }

.faq summary .ico {
  width: 30px;
  height: 30px;
  padding: 6px;
  border-radius: 50%;
  background: var(--blue-soft);
  color: var(--blue);
  transition: transform 0.3s ease-in-out, background 0.3s, color 0.3s;
}

.faq details[open] summary .ico { transform: rotate(45deg); background: var(--blue); color: var(--white); }

.faq details p { margin: 0; padding: 0 1.4rem 1.2rem; }

.faq details[open] p { animation: rise 0.35s ease both; }

/* Visit */

.visit-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
  gap: 1.5rem;
  align-items: stretch;
}

.visit-card {
  display: flex;
  flex-direction: column;
  gap: 1.4rem;
  padding: 1.75rem 2rem;
  border-radius: var(--radius);
  background: var(--blue-soft);
}

.contact-list { margin: 0; display: grid; gap: 0.8rem; }

.contact-list div {
  display: grid;
  grid-template-columns: 6.5rem 1fr;
  gap: 0.75rem;
  padding-top: 0.8rem;
  border-top: 1px solid rgba(2, 94, 234, 0.15);
}

.contact-list dt {
  display: flex;
  align-items: center;
  gap: 0.45rem;
  color: var(--muted);
  font-weight: 500;
}

.contact-list dt .ico { color: var(--blue); }

.contact-list dd { margin: 0; color: var(--ink); }

.contact-list a { font-weight: 500; text-decoration: none; }

.contact-list a:hover { text-decoration: underline; }

.map-frame {
  min-height: 320px;
  border-radius: var(--radius);
  overflow: hidden;
  background: var(--blue-soft);
  box-shadow: var(--shadow);
}

.map-frame iframe { display: block; width: 100%; height: 100%; min-height: 320px; border: 0; }

address {
  font-style: normal;
  margin: 0;
  color: var(--ink);
}

.visit-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 1.25rem;
}

/* Privacy page */

.plain-page { padding-bottom: 0; }

.policy { max-width: 44rem; padding-top: 3rem; }

.policy h1 { max-width: none; font-size: clamp(1.8rem, 3.4vw, 2.5rem); margin-bottom: 1rem; }

.policy h2 { margin-top: 2.2rem; font-size: 1.25rem; }

.policy h2::after { width: 36px; height: 3px; margin-top: 0.5rem; }

.policy p { margin: 0.8rem 0 0; }

/* Quick action dock */

.dock {
  position: fixed;
  z-index: 12;
  left: 50%;
  bottom: 1rem;
  transform: translateX(-50%);
  display: flex;
  gap: 0.2rem;
  padding: 0.35rem;
  background: var(--white);
  border-radius: 50px;
  box-shadow: 0 10px 40px rgba(0, 0, 0, 0.12);
}

.dock a {
  color: var(--ink);
  text-decoration: none;
  font-weight: 500;
  font-size: 0.92rem;
  padding: 0.55rem 1rem;
  border-radius: 50px;
  transition: all 0.2s ease-in-out;
}

.dock a:first-child { background: var(--pink-text); color: var(--white); }

.dock a:hover { color: var(--blue); background: var(--blue-soft); }

.dock a:first-child:hover { background: var(--blue); color: var(--white); }

/* Footer */

.site-footer {
  width: min(var(--measure), calc(100vw - 3rem));
  margin: 4.5rem auto 0;
  padding: 1.25rem 0 2rem;
  border-top: 1px solid var(--line);
  color: var(--muted);
  font-size: 0.9rem;
}

.site-footer {
  display: grid;
  grid-template-columns: auto 1fr;
  align-items: center;
  gap: 1.5rem 2.5rem;
  padding-top: 2rem;
}

.footer-brand { display: flex; align-items: center; gap: 0.9rem; }

.footer-brand img { width: 62px; height: auto; }

.footer-brand p { color: var(--ink); font-weight: 500; }

.footer-nav { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 0.25rem 1.4rem; }

.footer-nav a { color: var(--ink); text-decoration: none; font-weight: 500; }

.footer-base {
  grid-column: 1 / -1;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.5rem 1.5rem;
  padding-top: 1.1rem;
  border-top: 1px solid var(--line);
}

.footer-base p { margin-right: auto; }

.site-footer p { margin: 0; }

.site-footer a { color: var(--muted); }

.site-footer a:hover,
.footer-nav a:hover { color: var(--blue); }

.to-top { display: inline-flex; align-items: center; gap: 0.4rem; text-decoration: none; }

/* Motion */

.rise { opacity: 0; transform: translateY(24px); }

.rise.is-in { animation: rise 0.7s ease forwards; animation-delay: var(--d, 0ms); }

@keyframes zoomEffect {
  0% { transform: scale(0); }
  100% { transform: scale(1); }
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-8px); }
}

@keyframes rise {
  to { opacity: 1; transform: none; }
}

/* Responsive */

@media (max-width: 960px) {
  .care-list { grid-auto-columns: calc((100% - 1.5rem) / 2); }
  .visit-grid { grid-template-columns: 1fr; }
  .prep-grid { grid-template-columns: 1fr 1fr; }
  .site-footer { grid-template-columns: 1fr; }
  .footer-nav { justify-content: flex-start; }
}

@media (max-width: 800px) {
  .menu-button { display: inline-block; }

  .header-actions { margin-left: auto; }

  .site-header { padding-left: 1rem; padding-right: 1rem; gap: 0.75rem; }

  .topbar-item:first-child { display: none; }

  .topbar-inner { justify-content: center; }

  .site-nav {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    flex-direction: column;
    gap: 0;
    margin: 0;
    padding: 0.5rem;
    background: var(--white);
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.08);
  }

  .site-nav.is-open { display: flex; }

  .site-nav a { padding: 0.8rem 1.1rem; }

  .hero { grid-template-columns: 1fr; padding-top: 2.2rem; }

  .hero-art { max-width: 420px; }

  .band-head { align-items: flex-start; flex-direction: column; }

  .care-list { grid-auto-columns: 82%; }

  .fields { grid-template-columns: 1fr; }

  .request,
  .done,
  .visit-card { padding: 1.4rem; }

  .logo-link img { height: 56px; width: 70px; }
}

@media (max-width: 480px) {
  .call-button span { display: none; }

  .call-button { padding: 0.55rem 0.7rem; }

  .lang-switch,
  .menu-button { padding: 0.45rem 0.8rem; }

  .contact-list div { grid-template-columns: 1fr; gap: 0.2rem; }

  .prep-grid { grid-template-columns: 1fr; }

  .faq summary { padding: 0.95rem 1.1rem; }

  .faq details p { padding: 0 1.1rem 1.1rem; }
}

@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  .care-list { scroll-behavior: auto; }
  *,
  *::before,
  *::after { transition: none !important; animation: none !important; }
  .zoom-in,
  .rise { opacity: 1; transform: none; }
  .building .ln { stroke-dashoffset: 0; }
  .building .badge,
  .building .ltr,
  .building .backdrop,
  .building .ambulance,
  .building .walker { opacity: 1; transform: none; }
  .building .wash,
  .building .win,
  .building .cloud,
  .building .bird,
  .building .lane { opacity: 1; }
  .building .win.lit { fill: #ffd6e5; }
}
